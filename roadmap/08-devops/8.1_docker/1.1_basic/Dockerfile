# Базовый образ с Go. Внутри — Linux + Go SDK + инструменты.
FROM golang:1.22-alphine

# Рабочая директория внутри контейнера.
WORKDIR /app

# Копируем всё из текущей папки внутрь контейнера.
COPY . .

# Собираем бинарник.
RUN go build -o server .

# Открываем порт (документация, не публикация).
EXPOSE 8080

# Что запускать при старте контейнера.
CMD ["./server"]