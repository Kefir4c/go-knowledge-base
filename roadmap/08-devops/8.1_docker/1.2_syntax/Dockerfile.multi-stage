FROM golang:1.26-alpine AS builder

WORKDIR /app

# Cache mounts для ускорения (BuildKit)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cahce,target=/root/.cahce/go-build \
    true

# Сначала манифесты — для кэша
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download   

# Потом код
COPY . .    

ARG VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH=amd64

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
      -ldflags="-s -w -X main.version=$VERSION" \
      -trimpath \
      -o /app/server .

FROM gcr.io/distroless/static-debian12:nonroot

LABEL org.opencontainers.image.title="dockerfile-practice"
LABEL org.opencontainers.image.description="Production-ready Go image"

COPY --from=builder /app/server /server

USER nonroot:nonroot

EXPOSE 8080

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/server", "healthcheck"]

ENTRYPOINT ["/server"]