FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 go build -o /app/server .

# Второй stage — для рантайма.
FROM alpine:3.19

# Создаём пользователя с UID 1000.
RUN adduser -D -u 1000 appuser

WORKDIR /app

# COPY --from — из builder stage.
# --chown — файлы сразу принадлежат appuser.
COPY --from=builder --chown=1000:1000 /app/server /app/server

# USER — все последующие RUN и CMD от appuser.
USER appuser

EXPOSE 8080

CMD ["/app/server"]